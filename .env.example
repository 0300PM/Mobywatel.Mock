# Skopiuj do .env i uzupełnij. Nie udostępniaj pliku .env nikomu.
# Klucze API (zostaw puste te, których nie używasz)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# --- Cloudflare Workers AI (PROVIDER=workers) ---
# Adres workera wklej tutaj. Worker wystawia API zgodne z OpenAI (patrz cloudflare-worker/README.md).
# CLOUDFLARE_WORKERS_TOKEN to sekret WORKER_TOKEN ustawiony w workerze (opcjonalny).
# CLOUDFLARE_WORKERS_MODEL mozna tez wybrac w aplikacji (Pomoc i bezpieczenstwo -> Model LM Studio).
# CLOUDFLARE_WORKERS_URL=https://mobywatels-workers-ai.twoj-subdomen.workers.dev/v1
# CLOUDFLARE_WORKERS_TOKEN=
# CLOUDFLARE_WORKERS_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_WORKERS_TIMEOUT=60

# Dostawca modelu rozmowy: openai (domyslnie), anthropic, zgodny, lmstudio albo workers.
# Odkomentuj tylko JEDEN wiersz PROVIDER: on przelacza miedzy LM Studio a Cloudflare Workers.
# Pusta wartosc nie oznacza ustawienia domyslnego, wiec nie zostawiaj dwoch aktywnych.
# PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini

# PROVIDER=lmstudio  -> rozmowa przez lokalny serwer LM Studio (bez chmury)
# PROVIDER=workers   -> rozmowa przez Cloudflare Workers AI (adres workera wyzej)
# PROVIDER=zgodny    -> dowolne API zgodne z OpenAI

# API zgodne z OpenAI (np. polski model lokalnie), patrz README, sekcja „Polskie modele”
# OPENAI_BASE_URL=http://host.docker.internal:8000/v1
# MODEL=
# MODEL_API_KEY=

# LM Studio w Docker Compose: uruchom serwer na hoście na porcie 8791.
# Compose domyślnie używa tych wartości i modelu google/gemma-4-12b.
# PROVIDER=lmstudio (wiersz zakomentowany: dostawce wybierasz raz, wyzej)
# LM_STUDIO_BASE_URL=http://host.docker.internal:8791/v1
# LM_STUDIO_MODEL=google/gemma-4-12b
# LM_STUDIO_API_KEY=
# LM_STUDIO_TIMEOUT=60
# Proxy /v1/* do LM Studio: domyślnie WYŁĄCZONE. Na publicznym hostingu (Vercel) zostaw 0.
# Włączenie wymaga też tokenu: PROXY_TOKEN albo LM_STUDIO_API_KEY.
# LM_STUDIO_OPENAI_PROXY=0
# PROXY_TOKEN=

# Limity żądań AI (włączane jawnie) i budżet dobowy. Bez tych zmiennych limity nie działają.
# RATE_LIMIT_ON=1
# RATE_AGENT_PER_MIN=12
# RATE_AGENT_PER_DAY=300
# RATE_IP_PER_MIN=20
# RATE_IP_PER_DAY=1000
# AI_DAILY_BUDGET=0
# PROVIDER_CONCURRENCY=4
# PROVIDER_CONCURRENCY_ON=1

# Stan trwały żetonów znaku w chmurze: Vercel KV / Upstash (API REST). Bez tego Vercel trzyma go tylko w pamięci funkcji.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Stan lokalny (Docker): plik zamiast pamięci procesu.
# STATE_FILE=

# Jedna liczba rządzi limitami czasu: maxDuration funkcji Vercel (vercel.json). Timeouty wewnętrzne są zawsze krótsze.
# PLATFORM_TIMEOUT=120
# CHAT_TIMEOUT=60
# STT_TIMEOUT=45
# TTS_TIMEOUT=45
# TRANSLATE_TIMEOUT=30

# Głos
# STT_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=coral
# EL_VOICE=
# EL_TTS_MODEL=eleven_flash_v2_5
# EL_STT_MODEL=scribe_v2

# Nagłówki bezpieczeństwa (serwer/ustawienia.py → serwer.NAGLOWKI_BEZPIECZENSTWA)
# HTTPS_ONLY=1 dodaje Strict-Transport-Security. Włączaj tylko przy wdrożeniu za TLS —
# na localhost i w Vercelu (TLS terminuje platforma) zostaw wyłączone.
# HTTPS_ONLY=0
# CSP nadpisuje domyślną politykę Content-Security-Policy. Zmieniaj świadomie.
# CSP=
# LISTEN_BACKLOG=128
