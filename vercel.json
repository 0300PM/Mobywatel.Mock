{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:css",
  "installCommand": "npm install",
  "outputDirectory": "mockup",
  "rewrites": [
    { "source": "/komputer", "destination": "/komputer.html" },
    { "source": "/aplikacja", "destination": "/index.html" },
    { "source": "/aplikacja/:path*", "destination": "/:path*" },
    { "source": "/:lang(pl|en|uk|de|cs|sk|fr|es|it|nl|pt|ro|hu|sv|sl|el)/:path*", "destination": "/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).(css|js|svg|png|jpg|jpeg|webp|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{node_modules,cloudflare-worker,.git,testy,docs,mockup,serwer/i18n,serwer/wiedza,serwer/glosariusz}/**"
    }
  }
}
